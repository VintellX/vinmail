#!/bin/bash
# VinMail v1.1.2 - Terminal based Mail Manager
# "Bash-ing out an email."
set -uo pipefail

# LIB="/usr/lib/vinmail"
_self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
_self="$(realpath "$_self" 2>/dev/null || echo "$_self")"
LIB="$(dirname "$_self")/../lib/vinmail"
LIB="$(cd "$LIB" 2>/dev/null && pwd || echo "$LIB")"
source "$LIB/core.sh"
source "$LIB/ui.sh"
source "$LIB/accounts.sh"
source "$LIB/compose.sh"
source "$LIB/drafts.sh"

# ----- Main Menu -----
vinify() {
    local taken=0

    tput civis 2>/dev/null || true

    while true; do
        local d_count; d_count=$(draftCount)
        local draft_label="Drafts"
        [[ "$d_count" -gt 0 ]] && draft_label="Drafts (${d_count})"

        local options=(
            "Switch active account"
            "Add account"
            "Edit / Rename / Test"
            "Delete account"
            "Compose & send mail"
            "$draft_label"
            "Status"
            "Quit"
        )
        local total=${#options[@]}

        echoMainHeader
        for i in "${!options[@]}"; do
            [[ $i -eq $taken ]] \
                && echo -e "  ${GREEN}▶  ${BOLD}${options[$i]}${RESET}" \
                || echo -e "     ${options[$i]}"
        done

        readKeyboardo
        case "$KEY" in
            UP|k)   taken=$(( taken - 1 )); [[ $taken -lt 0 ]] && taken=$(( total - 1 )) ;;
            DOWN|j) taken=$(( taken + 1 )); [[ $taken -ge total ]] && taken=0 ;;
            ""|$'\n')
                tput cnorm 2>/dev/null || true 
                case $taken in
                    0) switchAccount ;; 1) addAccount  ;;
                    2) editAccount   ;; 3) delAccount  ;;
                    4) sendMail      ;; 5) showDrafts  ;;
                    6) showStatus    ;;
                    7) echo -e "\n${DIM}  Goodbye.${RESET}\n"; exit 0 ;;
                esac
                tput civis 2>/dev/null || true
                ;;
            q|Q)
                tput cnorm 2>/dev/null || true
                echo -e "\n${DIM}  Goodbye.${RESET}\n"; exit 0 ;;
        esac
    done
}

# ----- Dependency Check -----
checkDeps() {
    local hard=("msmtp" "sed" "awk" "grep" "base64")
    for cmd in "${hard[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo -e "${RED}  ✗ Missing required dependency: ${cmd}${RESET}"
            echo -e "${DIM}  Install it and try again.${RESET}"
            exit 1
        }
    done

    local soft=("gpg" "file")
    for cmd in "${soft[@]}"; do
        command -v "$cmd" >/dev/null 2>&1 || {
            warn "Optional dependency '${cmd}' not found."
            case "$cmd" in
                gpg)  info "GPG password encryption and mail signing will be unavailable." ;;
                file) info "MIME type detection for attachments will fall back to application/octet-stream." ;;
            esac
        }
    done
}

# ----- Run -----
mkdir -p "$VINMAIL_DIR"
checkDeps
acquireLock
init
vinify
